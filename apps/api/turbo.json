{
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["dist/**"],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "PORT",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "BETTER_AUTH_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GROQ_API_KEY",
        "BETTER_AUTH_URL",
        "WEB_URL",
        "SEQUENCE_LIVE_SEND_ENABLED"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "dev": {
      "dependsOn": ["^build"]
    }
  }
}
