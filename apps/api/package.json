{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "build": "tsc",
    "start": "bun run src/server.ts",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "pnpm build && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "pnpm build && drizzle-kit push",
    "db:studio": "pnpm build && drizzle-kit studio",
    "db:reset": "pnpm build && drizzle-kit push --force"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@workspace/validators": "workspace:*",
    "better-auth": "^1.2.8",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.7.4",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.2",
    "postgres": "^3.4.7",
    "resend": "^4.5.2"
  },
  "devDependencies": {
    "@types/bun": "^1.2.14",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.39.2",
    "typescript": "5.9.3"
  }
}
