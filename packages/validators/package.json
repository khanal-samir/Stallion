{
  "name": "@workspace/validators",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./schemas/common": {
      "types": "./src/schemas/common.validator.ts",
      "import": "./dist/schemas/common.validator.js"
    },
    "./schemas/auth": {
      "types": "./src/schemas/auth.validator.ts",
      "import": "./dist/schemas/auth.validator.js"
    },
    "./schemas/env": {
      "types": "./src/schemas/env.validator.ts",
      "import": "./dist/schemas/env.validator.js"
    },
    "./schemas/crm": {
      "types": "./src/schemas/crm.validator.ts",
      "import": "./dist/schemas/crm.validator.js"
    },
    "./schemas/sequence": {
      "types": "./src/schemas/sequence.validator.ts",
      "import": "./dist/schemas/sequence.validator.js"
    },
    "./schemas/workspace": {
      "types": "./src/schemas/workspace.validator.ts",
      "import": "./dist/schemas/workspace.validator.js"
